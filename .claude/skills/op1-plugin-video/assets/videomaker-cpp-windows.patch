+    folder = str(Path(path).parent) if path else None
+    for c in ("g++", "clang++", "c++"):
+        found = shutil.which(c, path=folder) if folder else None
+        if found:
+            return found
+    for c in ("g++", "clang++", "c++"):
+        if shutil.which(c):
+            return c
+    raise BuildError("no C++ compiler found for the plugin's C++ sources: install g++ or clang++, or set CXX")
